# Copy to .env (or set in Railway) — never commit real values.

# Neon Postgres connection string (same one your Vercel functions used)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/darkfantasy?sslmode=require

# Long random secret for signing JWTs (use: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-long-random-string

# Access tokens expire in 15 minutes, refresh tokens in 30 days
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Comma-separated list of allowed browser origins (your Vercel app URL)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:5199